---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import { copy } from "../content/copy";

// Meta tags only render once per HTTP response, so we pick theme A as the
// canonical default for SEO/share previews. The browser tab title can be
// updated via JS on theme change later if it matters.
const meta = copy.themeA.meta;
---

<Base title={meta.pageTitle} description={meta.pageDescription}>
  <Hero />
</Base>
