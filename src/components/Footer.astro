---
import Persona from "./Persona.astro";
---

<footer class="site-footer" data-reveal>
  <div class="footer-inner">
    <p class="footer-tagline"><Persona field="footer.tagline" /></p>
    <p class="footer-copyright"><Persona field="footer.copyright" /></p>
    <div class="footer-links">
      {/* Persistent Resume link — same label both themes (locked rule).
          Native <a download> so it works without JS, and ClientRouter
          ignores `download` links (no soft-nav for file downloads). */}
      <a class="footer-resume" href="/resume.pdf" download>
        <Persona field="footer.resumeLink" />
      </a>
      <a class="footer-back-to-top" href="#hero">
        <Persona field="footer.backToTop" /> ↑
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-6) var(--space-5) var(--space-5);
    border-top: 1px solid var(--border);
    margin-top: var(--space-7);
  }
  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .footer-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--fg);
    margin: 0;
  }
  .footer-copyright {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0;
  }
  .footer-links {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .footer-resume,
  .footer-back-to-top {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease-out;
  }
  .footer-resume:hover,
  .footer-back-to-top:hover {
    border-bottom-color: var(--accent);
  }
</style>
