---
import Persona from "./Persona.astro";
import { copy } from "../content/copy";
import { skillItems, skillOrder } from "../content/skills";
---

<section class="skills" id="skills">
  <header class="skills-header">
    <p class="section-label"><Persona field="skills.sectionLabel" /></p>
    <p class="section-tagline"><Persona field="skills.sectionTagline" /></p>
  </header>

  <div class="skills-grid">
    {skillOrder.map((key) => (
      <div class="skill-bucket">
        <h3 class="skill-category">
          <span data-persona="A">{copy.themeA.skills.categories[key]}</span><span data-persona="B">{copy.themeB.skills.categories[key]}</span>
        </h3>
        <ul class="skill-items">
          {skillItems[key].map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .skills {
    padding: var(--space-8) var(--space-5);
    max-width: 1100px;
    margin: 0 auto;
  }
  .skills-header {
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin: 0 0 var(--space-3);
  }
  .section-tagline {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.2;
    color: var(--fg);
    margin: 0;
  }

  .skills-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .skill-bucket {
    border-top: 1px solid var(--border);
    padding-top: var(--space-3);
  }
  .skill-category {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: 1.15rem;
    color: var(--accent);
    margin: 0 0 var(--space-3);
    line-height: 1.3;
  }
  .skill-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .skill-items li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.6rem;
    opacity: 0.92;
  }
</style>
