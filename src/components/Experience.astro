---
import Persona from "./Persona.astro";
import { roles } from "../content/experience";
import { copy } from "../content/copy";
---

<section class="experience" id="experience" data-reveal>
  <header class="experience-header">
    <p class="section-label"><Persona field="experience.sectionLabel" /></p>
    <h2 class="section-tagline"><Persona field="experience.sectionTagline" /></h2>
  </header>

  <ol class="timeline">
    {roles.map((role, i) => {
      const isCurrent = !role.end;
      return (
        <li class="role" style={`--role-index: ${i};`}>
          <div class="role-meta">
            <span class="role-dates">
              {role.start} – {isCurrent ? (
                <em class="present-label">
                  <span data-persona="A">{copy.themeA.experience.presentLabel}</span><span data-persona="B">{copy.themeB.experience.presentLabel}</span>
                </em>
              ) : role.end}
            </span>
            <span class="role-location">{role.location}</span>
          </div>
          <h3 class="role-title">{role.title}</h3>
          <p class="role-company">{role.company}</p>
          <ul class="role-achievements">
            {role.achievements.map((a) => <li>{a}</li>)}
          </ul>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .experience {
    padding: var(--space-8) var(--space-5);
    max-width: 900px;
    margin: 0 auto;
  }
  .experience-header {
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--accent);
    margin: 0 0 var(--space-3);
  }
  .section-tagline {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.2;
    color: var(--fg);
    margin: 0;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border);
  }
  .role {
    position: relative;
    padding: 0 0 var(--space-6) var(--space-5);
  }
  .role::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 0.5rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }

  .role-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .role-dates {
    color: var(--accent);
  }
  .present-label {
    font-style: normal;
  }
  .role-title {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    color: var(--fg);
    margin: 0;
    line-height: 1.2;
  }
  .role-company {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--fg);
    opacity: 0.85;
    margin: 0.2rem 0 var(--space-3);
  }
  .role-achievements {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .role-achievements li {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--fg);
    opacity: 0.85;
    padding-left: var(--space-3);
    position: relative;
  }
  .role-achievements li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: bold;
  }
</style>
